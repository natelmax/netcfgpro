{{- /* Cisco IOS/IOS-XE Configuration Template */ -}}
!
! Generated by NetConfigPro (Go Version)
! Vendor: {{ .Vendor }}
!
hostname {{ .Hostname }}
!
{{- if .GetEnableSecret }}
enable secret {{ .GetEnableSecret }}
{{- end }}
{{- if .GetDomainName }}
ip domain-name {{ .GetDomainName }}
{{- end }}
!
{{- if .DNSServers }}
{{- range .DNSServers }}
ip name-server {{ . }}
{{- end }}
{{- end }}
!
{{- if .NTPServers }}
{{- range .NTPServers }}
ntp server {{ . }}
{{- end }}
{{- end }}
!
{{- if .BannerMOTD }}
banner motd ^
{{ .BannerMOTD }}
^
{{- end }}
!
{{- /* Spanning Tree Configuration */}}
{{- if .STP }}
spanning-tree mode {{ .STP.Mode }}
{{- if ne .STP.Priority 32768 }}
spanning-tree vlan 1-4094 priority {{ .STP.Priority }}
{{- end }}
{{- range .STP.RootPrimaryVLANs }}
spanning-tree vlan {{ . }} root primary
{{- end }}
{{- range .STP.RootSecondaryVLANs }}
spanning-tree vlan {{ . }} root secondary
{{- end }}
{{- if .STP.PortfastDefault }}
spanning-tree portfast default
{{- end }}
{{- if .STP.BPDUGuardDefault }}
spanning-tree portfast bpduguard default
{{- end }}
!
{{- end }}
{{- /* VLANs */}}
{{- if .VLANs }}
{{- range .VLANs }}
vlan {{ .ID }}
 name {{ .Name }}
{{- if .Description }}
 ! {{ .Description }}
{{- end }}
{{- if ne .State "active" }}
 state {{ .State }}
{{- end }}
!
{{- end }}
{{- end }}
!
{{- /* Interfaces */}}
{{- range .Interfaces }}
interface {{ .Name }}
{{- if .Description }}
 description {{ .Description }}
{{- end }}
{{- if not .GetIsEnabled }}
 shutdown
{{- else }}
 no shutdown
{{- end }}
{{- /* L2 Switchport Configuration */}}
{{- if .SwitchportMode }}
{{- if eq .SwitchportMode "access" }}
 switchport mode access
{{- if .GetAccessVLAN }}
 switchport access vlan {{ .GetAccessVLAN }}
{{- end }}
{{- if .GetVoiceVLAN }}
 switchport voice vlan {{ .GetVoiceVLAN }}
{{- end }}
{{- else if eq .SwitchportMode "trunk" }}
 switchport mode trunk
{{- if .GetTrunkNativeVLAN }}
 switchport trunk native vlan {{ .GetTrunkNativeVLAN }}
{{- end }}
{{- if .GetTrunkAllowedVLANs }}
 switchport trunk allowed vlan {{ .GetTrunkAllowedVLANs }}
{{- end }}
{{- else }}
 switchport mode {{ .SwitchportMode }}
{{- end }}
{{- end }}
{{- /* L3 Configuration */}}
{{- if and .GetIPAddress .GetSubnetMask }}
 ip address {{ .GetIPAddress }} {{ .GetSubnetMask }}
{{- end }}
{{- if .GetSpeed }}
 speed {{ .GetSpeed }}
{{- end }}
{{- if .GetDuplex }}
 duplex {{ .GetDuplex }}
{{- end }}
{{- if ne .MTU 1500 }}
 mtu {{ .MTU }}
{{- end }}
{{- if .GetChannelGroup }}
 channel-group {{ .GetChannelGroup }} mode {{ .GetChannelGroupMode }}
{{- end }}
!
{{- end }}
!
{{- /* ACLs */}}
{{- range .ACLs }}
{{- if .GetIsExtended }}
ip access-list extended {{ .Name }}
{{- else }}
ip access-list standard {{ .Name }}
{{- end }}
{{- range .Entries }}
{{- if .Remark }}
 {{ .Sequence }} remark {{ .Remark }}
{{- else }}
 {{ .Sequence }} {{ .Action }} {{ .Protocol }} {{ .Source }}{{ if ne .SourceWildcard "0.0.0.0" }} {{ .SourceWildcard }}{{ end }}{{ if .GetSourcePort }} eq {{ .GetSourcePort }}{{ end }} {{ .Destination }}{{ if ne .DestinationWildcard "0.0.0.0" }} {{ .DestinationWildcard }}{{ end }}{{ if .GetDestinationPort }} eq {{ .GetDestinationPort }}{{ end }}{{ if .Log }} log{{ end }}
{{- end }}
{{- end }}
!
{{- end }}
!
{{- /* Static Routes */}}
{{- range .StaticRoutes }}
ip route {{ .Destination }} {{ .Mask }} {{ .NextHop }}{{ if ne .AdminDistance 1 }} {{ .AdminDistance }}{{ end }}{{ if .Name }} name {{ .Name }}{{ end }}{{ if .Permanent }} permanent{{ end }}
{{- end }}
!
{{- /* Prefix Lists */}}
{{- range .PrefixLists }}
{{- range .Entries }}
ip prefix-list {{ .Name }} seq {{ .Sequence }} {{ .Action }} {{ .Prefix }}{{ if .GetGE }} ge {{ .GetGE }}{{ end }}{{ if .GetLE }} le {{ .GetLE }}{{ end }}
{{- end }}
{{- end }}
!
{{- /* Route Maps */}}
{{- range .RouteMaps }}
{{- range .Entries }}
route-map {{ .Name }} {{ .Action }} {{ .Sequence }}
{{- if .GetMatchPrefixList }}
 match ip address prefix-list {{ .GetMatchPrefixList }}
{{- end }}
{{- if .GetMatchASPath }}
 match as-path {{ .GetMatchASPath }}
{{- end }}
{{- if .GetMatchCommunity }}
 match community {{ .GetMatchCommunity }}
{{- end }}
{{- if .GetSetLocalPref }}
 set local-preference {{ .GetSetLocalPref }}
{{- end }}
{{- if .GetSetMED }}
 set metric {{ .GetSetMED }}
{{- end }}
{{- if .GetSetWeight }}
 set weight {{ .GetSetWeight }}
{{- end }}
{{- if .GetSetASPathPrepend }}
 set as-path prepend {{ .GetSetASPathPrepend }}
{{- end }}
{{- if .GetSetCommunity }}
 set community {{ .GetSetCommunity }}
{{- end }}
{{- if .GetSetNextHop }}
 set ip next-hop {{ .GetSetNextHop }}
{{- end }}
!
{{- end }}
{{- end }}
!
{{- /* OSPF */}}
{{- if .OSPF }}
router ospf {{ .OSPF.ProcessID }}
{{- if .OSPF.GetRouterID }}
 router-id {{ .OSPF.GetRouterID }}
{{- end }}
{{- if ne .OSPF.ReferenceBandwidth 100 }}
 auto-cost reference-bandwidth {{ .OSPF.ReferenceBandwidth }}
{{- end }}
{{- range .OSPF.Networks }}
 network {{ .Network }} {{ .Wildcard }} area {{ .Area }}
{{- end }}
{{- range .OSPF.PassiveInterfaces }}
 passive-interface {{ . }}
{{- end }}
{{- if .OSPF.DefaultInformationOriginate }}
 default-information originate
{{- end }}
!
{{- end }}
!
{{- /* EIGRP */}}
{{- if .EIGRP }}
{{- if .EIGRP.NamedMode }}
router eigrp {{ .EIGRP.Name }}
 !
 address-family ipv4 unicast autonomous-system {{ .EIGRP.ASNumber }}
  !
{{- if .EIGRP.GetRouterID }}
  eigrp router-id {{ .EIGRP.GetRouterID }}
{{- end }}
{{- range .EIGRP.Networks }}
  network {{ .Network }}{{ if .GetWildcard }} {{ .GetWildcard }}{{ end }}
{{- end }}
{{- range .EIGRP.PassiveInterfaces }}
  passive-interface {{ . }}
{{- end }}
{{- range .EIGRP.Redistribute }}
  redistribute {{ . }}
{{- end }}
  exit-address-family
{{- else }}
router eigrp {{ .EIGRP.ASNumber }}
{{- if .EIGRP.GetRouterID }}
 eigrp router-id {{ .EIGRP.GetRouterID }}
{{- end }}
{{- if not .EIGRP.AutoSummary }}
 no auto-summary
{{- end }}
{{- range .EIGRP.Networks }}
 network {{ .Network }}{{ if .GetWildcard }} {{ .GetWildcard }}{{ end }}
{{- end }}
{{- range .EIGRP.PassiveInterfaces }}
 passive-interface {{ . }}
{{- end }}
{{- range .EIGRP.Redistribute }}
 redistribute {{ . }}
{{- end }}
{{- end }}
!
{{- end }}
!
{{- /* BGP */}}
{{- if .BGP }}
router bgp {{ .BGP.LocalAS }}
{{- if .BGP.GetRouterID }}
 bgp router-id {{ .BGP.GetRouterID }}
{{- end }}
{{- if .BGP.GetLogNeighborChanges }}
 bgp log-neighbor-changes
{{- end }}
{{- range .BGP.Networks }}
 network {{ . }}
{{- end }}
{{- range .BGP.Neighbors }}
 neighbor {{ .IPAddress }} remote-as {{ .RemoteAS }}
{{- if .Description }}
 neighbor {{ .IPAddress }} description {{ .Description }}
{{- end }}
{{- if .GetPassword }}
 neighbor {{ .IPAddress }} password {{ .GetPassword }}
{{- end }}
{{- if .GetUpdateSource }}
 neighbor {{ .IPAddress }} update-source {{ .GetUpdateSource }}
{{- end }}
{{- if gt .EBGPmultihop 0 }}
 neighbor {{ .IPAddress }} ebgp-multihop {{ .EBGPmultihop }}
{{- end }}
{{- if .GetRouteMapIn }}
 neighbor {{ .IPAddress }} route-map {{ .GetRouteMapIn }} in
{{- end }}
{{- if .GetRouteMapOut }}
 neighbor {{ .IPAddress }} route-map {{ .GetRouteMapOut }} out
{{- end }}
{{- end }}
!
{{- end }}
!
end
